{
  "name": "marble-race-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "vite",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build": "tsc && vite build",
    "build:demo": "vite build --config vite.demo.config.ts && cp dist-demo/demo.html dist-demo/index.html",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@twa-dev/sdk": "^8.0.2",
    "matter-js": "^0.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/matter-js": "^0.19.7",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
